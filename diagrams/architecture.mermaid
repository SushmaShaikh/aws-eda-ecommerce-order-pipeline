flowchart TD
    Customer([Customer clicks Place Order])
    APIGW[API Gateway]
    OrderLambda[Order Lambda<br/>writes order as PENDING]
    DDB[(DynamoDB<br/>Orders table)]
    EB{{EventBridge<br/>OrderPlaced event}}

    Customer --> APIGW
    APIGW --> OrderLambda
    OrderLambda --> DDB
    OrderLambda --> EB

    EB --> InvQ[[SQS: Inventory Queue]]
    EB --> PayQ[[SQS: Payment Queue]]
    EB --> NotifyQ[[SQS: Notification Queue]]
    EB --> Firehose[Kinesis Firehose]

    InvQ --> InvSvc[Inventory Service<br/>reserve stock]
    PayQ --> PaySvc[Payment Service<br/>charge customer]
    NotifyQ --> NotifySvc[Notification Service]
    Firehose --> S3[(S3 Data Lake)]

    NotifySvc --> SNS([SNS: Order Confirmation Email])

    InvSvc --> SF{Step Functions<br/>Order Orchestrator}
    PaySvc --> SF

    SF -->|both succeeded| Confirmed[OrderConfirmed event]
    SF -->|either failed| Compensate[Compensate:<br/>release inventory / refund]

    Confirmed --> Shipping[Shipping Service]

    InvQ -.retries exhausted.-> InvDLQ[(Dead Letter Queue)]
    PayQ -.retries exhausted.-> PayDLQ[(Dead Letter Queue)]
    NotifyQ -.retries exhausted.-> NotifyDLQ[(Dead Letter Queue)]

    classDef sync fill:#4db8ff,stroke:#1a1a2e,color:#000
    classDef event fill:#ff9900,stroke:#1a1a2e,color:#000
    classDef consumer fill:#4dff91,stroke:#1a1a2e,color:#000
    classDef orch fill:#e74c3c,stroke:#1a1a2e,color:#fff
    classDef dlq fill:#888,stroke:#1a1a2e,color:#fff,stroke-dasharray: 3 3

    class Customer,APIGW,OrderLambda,DDB sync
    class EB,Confirmed event
    class InvSvc,PaySvc,NotifySvc,SNS,Firehose,S3,Shipping consumer
    class SF,Compensate orch
    class InvDLQ,PayDLQ,NotifyDLQ dlq
